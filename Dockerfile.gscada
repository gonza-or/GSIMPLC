# Imagen del appliance GSCADA — corre gscada.bin (maestro Modbus TCP +
# servidor web SCADA/HMI + historiador + alarmas).
#
# Mismo patron que la imagen gsimplc: ubuntu 22.04, sshd, tini,
# manage.sh y healthcheck contra la web del GSCADA.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV GSIMPLC_BIN=gscada

RUN apt-get update && apt-get install -y --no-install-recommends \
        iproute2 openssh-server ca-certificates python3-minimal \
        ifupdown isc-dhcp-client \
        sqlite3 curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd /var/log /etc/gsimplc

COPY gns3/scripts/gscada.args /etc/gsimplc/gscada.args
COPY gns3/scripts/manage.sh /usr/local/bin/gsimplc-manage
COPY gns3/scripts/show-logs.sh /usr/local/bin/gsimplc-show-logs

COPY dist/gscada.bin /usr/local/bin/gscada.bin
COPY gscada/configs /opt/gsimplc/gscada/configs
COPY gscada/static /opt/gsimplc/gscada/static

RUN useradd -m -s /bin/bash gns3 \
    && echo "gns3:gns3" | chpasswd \
    && mkdir -p /home/gns3/.ssh \
    && chown -R gns3:gns3 /home/gns3
RUN sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

RUN chmod +x /usr/local/bin/gscada.bin /usr/local/bin/gsimplc-manage /usr/local/bin/gsimplc-show-logs

EXPOSE 22 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://localhost:8080/api/plcs >/dev/null || exit 1

COPY gns3/scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
