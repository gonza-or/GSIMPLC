        "extra_hosts": "",
        "extra_volumes": [],
        "custom_adapters": []
    },
    "port_name_format": "eth{0}",
    "port_segment_size": 0,
    "usage": "Args por defecto en /etc/gsimplc/gsimplc.args. Se cambian con gsimplc-manage set-args."
